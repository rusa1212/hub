GEMINI_API_KEY=
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
# 선택: Gemini TTS 프리셋 목소리 이름 (기본값 Kore)
GEMINI_TTS_VOICE=Kore

# Supabase 대시보드 > Project Settings > API 에서 확인
SUPABASE_URL=
# anon 키가 아닌 service_role 키 (백엔드 전용, 절대 프론트에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=

# 선택: 사용자 1명당 하루 STT/TTS 사용 한도 (관리자 화면의 "남은 횟수" 기준, 기본 100/150)
STT_DAILY_LIMIT=100
TTS_DAILY_LIMIT=150
# 선택: 하루를 끊는 기준 시간대 (기본 Asia/Seoul)
USAGE_TIMEZONE=Asia/Seoul
