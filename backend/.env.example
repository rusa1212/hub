GEMINI_API_KEY=
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
# 선택: Gemini TTS 프리셋 목소리 이름 (기본값 Kore)
GEMINI_TTS_VOICE=Kore

# Supabase 대시보드 > Project Settings > API 에서 확인
SUPABASE_URL=
# anon 키가 아닌 service_role 키 (백엔드 전용, 절대 프론트에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=

# 선택: 프로젝트(API 키) 전체의 하루 호출 쿼터. Gemini 무료 티어가 실제로 거는 한도이며
# 관리자 화면의 "오늘 남은 호출"이 이 값을 기준으로 계산된다.
# 계정별 정확한 값은 https://aistudio.google.com/rate-limit 에서 확인해 넣을 것.
# 비워두면 STT는 "모름"(사용량만 집계), TTS는 10(docs/4th_wk/tues.md 실측치)이 기본값.
STT_PROJECT_DAILY_QUOTA=
TTS_PROJECT_DAILY_QUOTA=10

# 선택: 사용자 1명당 하루 상한. 한 사람이 위 쿼터를 통째로 쓰지 못하게 막는 남용 방지용이며
# Gemini 쿼터와는 무관한 우리가 정하는 값 (기본 100/150).
STT_USER_DAILY_LIMIT=100
TTS_USER_DAILY_LIMIT=150

# 선택: 하루를 끊는 기준 시간대 (기본 Asia/Seoul)
USAGE_TIMEZONE=Asia/Seoul
